   "source": [
    "Enums are the only way to create constants in python.We cannot reassign the values in it again and again."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "93626bc0",
   "metadata": {},
   "outputs": [],
   "source": [
    "from enum import Enum\n",
    "\n",
    "class State(Enum):\n",
    "    INACTIVE=0\n",
    "    ACTIVE=1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "789767d4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1\n"
     ]
    }
   ],
   "source": [
    "print(State.ACTIVE.value)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "eb9f77a8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2\n"
     ]
    }
   ],
   "source": [
    "print(len(State))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "1237ac39",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "<class 'enum.EnumType'>\n"
     ]
    }
   ],
   "source": [
    "print(type(State))"
   ]
  },
